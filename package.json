{
  "name": "psicho-hub-api",
  "version": "1.0.0",
  "description": "API para gerenciamento e análise de dados de pacientes psicológicos.",
  "main": "src/http/server.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/http/server.ts",
    "lint": "biome check --write ./src",
    "build": "tsup",
    "start": "node dist/http/server.js",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/database/drizzle/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@scalar/fastify-api-reference": "^1.53.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "pg": "^8.20.0",
    "resend": "^6.12.3",
    "tldts": "^7.0.29",
    "zod": "^4.3.6"
  }
}